# Copy to .env (or export in your shell). Never commit real values.

# Read-only HubSpot private-app token (scopes: crm.objects.contacts.read,
# crm.objects.calls.read, crm.objects.emails.read, crm.schemas.*.read,
# crm.objects.owners.read). NO write scopes — this tool never writes to HubSpot.
HUBSPOT_TOKEN=

# Anthropic API key for extraction and deck-fit. If you use `ant auth login`
# instead, the SDK resolves that profile automatically and this can stay unset.
ANTHROPIC_API_KEY=
